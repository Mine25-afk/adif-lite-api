# Copia este archivo a .env (está en .gitignore) y reemplaza los valores de ejemplo.

# ---- PostgreSQL ----
POSTGRES_DB=adif_lite
POSTGRES_USER=adif
POSTGRES_PASSWORD=cambia-esta-clave-local

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
# Id del proyecto de Firebase cuyos idToken se aceptan (Configuración del proyecto > General).
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# ---- Integraciones (opcionales en local) ----
# Clave que el agente de Kapso envía en X-API-Key a /api/v1/fiado/*. Vacía = esos endpoints rechazan todo.
KAPSO_TOOLS_API_KEY=
# API key global de Kapso para enviar mensajes. Vacía = el bot simula los envíos.
KAPSO_PROJECT_API_KEY=
# Cadena de Azure Blob Storage para imágenes de productos.
AZURE_BLOB_CONNECTION=
